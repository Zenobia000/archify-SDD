    "trace": {
      "id": "schema-booking",
      "refines": [
        "dfd-booking"
      ],
      "elements": {
        "appointments": "D-10",
        "slots": "D-11",
        "payments": "D-12"
      }
    },
    "views": [
      {
        "id": "booking-core",
        "label": "Booking core",
        "focus": [
          "appointments",
          "slots",
          "patients",
          "doctors"
        ],
        "note": "An appointment joins one patient to one slot; each slot belongs to one doctor."
      },
      {
        "id": "deposit",
        "label": "Deposits and refunds",
        "focus": [
          "payments",
          "appointments"
        ],
        "note": "Each appointment carries a deposit row and, when refunded, a refund row."
      },
      {
        "id": "messaging",
        "label": "Reminders and outbox",
        "focus": [
          "reminders",
          "outbox_events",
          "appointments"
        ],
        "note": "The outbox row is written in the same transaction as the confirmed appointment."
      }
    ]
  },
