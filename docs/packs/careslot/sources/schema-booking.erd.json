  "cards": [
    {
      "dot": "cyan",
      "title": "Keys and uniqueness",
      "items": [
        "slots is unique on (doctor_id, starts_at): one doctor cannot open two slots at the same start.",
        "payments.provider_intent_id is unique, so a replayed provider webhook cannot settle twice.",
        "reminders is unique on (appointment_id, lead_time): one 24h and one 2h reminder per visit."
      ]
    },
    {
      "dot": "amber",
      "title": "Holds and states",
      "items": [
        "A hold sets slots.held_until and appointments.hold_expires_at to now + 10 minutes.",
        "appointments.status moves held, confirmed, reminded, checked_in, completed; or expired, cancelled, no_show.",
        "version columns give optimistic locking on slot and appointment updates."
      ]
    },
    {
      "dot": "emerald",
      "title": "Outbox",
      "items": [
        "Confirming writes the appointment update and an outbox_events row in one transaction.",
        "published_at stays null until the Outbox Publisher has delivered the event to the Event Bus.",
        "The outbox link is non-identifying: events outlive retries and are drawn dashed."
      ]
    }
  ]
}
