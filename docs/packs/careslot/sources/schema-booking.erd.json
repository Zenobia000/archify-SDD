  "diagram_type": "erd",
  "meta": {
    "title": "CareSlot booking schema",
    "locale": "en",
    "output": "schema-booking.html",
    "visual_preset": "reference",
    "quality_profile": "showcase",
    "viewpoint": {
      "level": "implementation",
