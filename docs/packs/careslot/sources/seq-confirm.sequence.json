  "cards": [
    {
      "dot": "emerald",
      "title": "Hold, then pay",
      "items": [
        "The slot is reserved for 10 minutes before any money moves.",
        "The patient pays in the browser with the client secret; the API never sees card data.",
        "An unpaid hold expires and the slot reopens."
      ]
    },
    {
      "dot": "rose",
      "title": "Confirmation is payment-driven",
      "items": [
        "Only the signed provider webhook confirms the appointment.",
        "The payment intent id is unique, so a replayed webhook changes nothing."
      ]
    },
    {
      "dot": "orange",
      "title": "Reliable events",
      "items": [
        "The outbox row commits with the confirmed appointment, so the event cannot be lost.",
        "Publishing is asynchronous and retried; the webhook is answered before it happens.",
        "Reminder Worker schedules reminders 24 h and 2 h before the visit."
      ]
    }
