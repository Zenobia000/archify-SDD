  "cards": [
    {
      "dot": "emerald",
      "title": "送出與產生關卡",
      "items": [
        "送出時預扣額度；不足則不能送出",
        "代理人拒絕即退回申請人",
        "超過 3 天加部門主管關；婚假、喪假、公假及超過 3 天病假加人資關",
        "主管在代理期間內，關卡自動轉給代理主管"
      ]
    },
    {
      "dot": "amber",
      "title": "簽核分支",
      "items": [
        "退回補件：重送時從被退回的關卡重新簽，已簽紀錄保留",
        "加簽：簽核人可臨時加一關",
        "會簽：多人並簽，全部同意才通過，任一駁回即駁回"
      ]
    },
    {
      "dot": "rose",
      "title": "逾時與結束",
      "items": [
        "關卡 24 小時未簽發提醒，48 小時自動升級給上一層主管",
        "核准時實扣額度並同步出勤、薪資、行事曆",
        "駁回時回補預扣的額度"
      ]
    }
