  "cards": [
    {
      "dot": "cyan",
      "title": "執行路徑",
      "items": [
        "員工、代理人與主管都經員工入口操作，人資使用人資後台",
        "請假服務負責假單、額度與動態簽核關卡，請假資料庫為唯一事實來源"
      ]
    },
    {
      "dot": "emerald",
      "title": "簽核內建",
      "items": [
        "簽核是請假服務內的模組，沒有獨立簽核服務或外部 BPM（ADR-0001）",
        "排程工作者每輪呼叫 API：24 小時提醒、48 小時升級、年度發額"
      ]
    },
    {
      "dot": "violet",
      "title": "非同步整合",
      "items": [
        "請假服務以交易性 outbox 發佈事件到 RabbitMQ",
        "整合工作者同步出勤、通知薪資、寫入行事曆並送出通知"
      ]
    },
    {
      "dot": "rose",
      "title": "身分",
      "items": [
        "兩個 SPA 皆經企業 SSO 以 OIDC 登入",
        "請假服務驗證 token，並依 HRIS 的主管關係檢查角色與部門範圍"
      ]
    }
  ]
