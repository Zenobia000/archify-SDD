  "cards": [
    {
      "dot": "cyan",
      "title": "鍵與唯一性",
      "items": [
        "leave_balances 在 (employee_id, leave_type_id, year) 唯一：每人每年每種假別一列額度。",
        "approval_steps 在 (leave_request_id, round, seq, approver_id) 唯一；同 seq 多列即為一組會簽。",
        "employees、org_units 由 HRIS 同步；sso_subject 對應企業 SSO 的 OIDC sub。"
      ]
    },
    {
      "dot": "amber",
      "title": "關卡與動作",
      "items": [
        "mode：SEQUENTIAL 單人關卡；ALL 會簽全部同意才通過；ANY 任一人同意即通過。會簽任一駁回即駁回。",
        "加簽寫入 approval_actions（action＝加簽），並新增 approval_steps 列，inserted_by 記錄加簽者。",
        "退回後重送：round 加一，從 resume_seq 起重新簽；舊輪次的動作列保留不刪。",
        "remind_at＝開始後 24 小時提醒；due_at＝48 小時，逾時升級並填 escalated_to。"
      ]
    },
    {
      "dot": "violet",
      "title": "圖中未畫的外鍵",
      "items": [
        "approval_steps 的 approver_id、acting_approver_id、inserted_by、escalated_to 皆指向 employees.id。",
        "approval_actions 的 actor_id、on_behalf_of 指向 employees.id；added_step_id 指向 approval_steps.id。",
        "org_units.manager_id、employees.manager_id 指向 employees.id；parent_id 為自我參照。"
      ]
    },
    {
      "dot": "emerald",
      "title": "額度與 outbox",
      "items": [
        "送出時增加 reserved_hours（預扣）；核准時轉入 used_hours（實扣）；駁回、撤回、銷假時回補。",
        "假單狀態變更與 outbox_events 列在同一交易寫入；published_at 為 NULL 者由發佈器送往 RabbitMQ。"
      ]
    }
  ]
}
