  "cards": [
    {
      "dot": "cyan",
      "title": "範圍",
      "items": [
        "本層只畫一個系統框；容器見 C4 L2",
        "簽核內建於請假服務，不使用外部 BPM（ADR-0001）"
      ]
    },
    {
      "dot": "emerald",
      "title": "簽核規則",
      "items": [
        "送出後先由代理人確認，拒絕則退回申請人",
        "≤ 3 天由直屬主管簽；> 3 天加部門主管",
        "婚假、喪假、公假與 > 3 天病假須附證明並加人資關"
      ]
    },
    {
      "dot": "violet",
      "title": "核准後同步",
      "items": [
        "非同步同步出勤、通知薪資、寫入行事曆",
        "通知申請人與代理人；關卡 24 小時提醒、48 小時升級"
      ]
    },
    {
      "dot": "rose",
      "title": "信任",
      "items": [
        "所有使用者經企業 SSO 以 OIDC 登入",
        "主管關係與職級以 HRIS 為準"
      ]
    }
  ]
