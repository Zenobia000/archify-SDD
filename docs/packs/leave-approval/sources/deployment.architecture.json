  "cards": [
    {
      "dot": "cyan",
      "title": "部署假設",
      "items": [
        "目標部署：地端 K8s 叢集位於公司內網，只開放內部 Ingress",
        "PostgreSQL 與 RabbitMQ 以 StatefulSet 跑在同一 namespace",
        "副本數與節點數為設計假設，非量測結果"
      ]
    },
    {
      "dot": "emerald",
      "title": "資料",
      "items": [
        "請假資料庫為單一主節點，串流複寫到唯讀副本",
        "資料層只允許叢集內應用連線 5432"
      ]
    },
    {
      "dot": "rose",
      "title": "對外連線",
      "items": [
        "請假服務連企業 SSO 與 HRIS；整合工作者連出勤、薪資、通知與行事曆",
        "外部系統位於公司內網之外，經防火牆放行的出站連線"
      ]
    }
