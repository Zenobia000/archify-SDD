  "messages": [
    {
      "id": "approve-request",
      "from": "employee-portal",
      "to": "rest-controller",
      "y": 182,
      "label": "POST 核准關卡",
      "variant": "emphasis",
      "note": "OIDC token 經身分驗證；附簽核意見"
    },
    {
      "id": "call-approve",
      "from": "rest-controller",
      "to": "approval-service",
      "y": 238,
      "label": "approve(stepId)",
      "variant": "emphasis"
    },
    {
      "id": "check-delegation",
      "from": "approval-service",
      "to": "delegation-resolver",
      "y": 278,
      "label": "檢查代理權限",
      "variant": "security",
      "note": "本人，或 delegations 期間內的代理主管"
    },
    {
      "id": "delegation-ok",
      "from": "delegation-resolver",
      "to": "approval-service",
      "y": 350,
      "label": "允許 · 實際簽核人",
      "variant": "return"
    },
    {
      "id": "record-action",
      "from": "approval-service",
      "to": "leave-db",
      "y": 384,
      "label": "記錄核准動作",
      "variant": "default",
      "note": "開啟交易：新增 approval_actions 列，本人關卡設為已同意"
    },
    {
      "id": "action-saved",
      "from": "leave-db",
      "to": "approval-service",
      "y": 444,
      "label": "已寫入",
      "variant": "return"
    },
    {
      "id": "check-group",
      "from": "approval-service",
      "to": "routing-engine",
      "y": 484,
      "label": "會簽是否全部同意",
      "variant": "default",
      "note": "ALL 全員同意、ANY 一人同意；任一駁回即駁回"
    },
    {
      "id": "group-done",
      "from": "routing-engine",
      "to": "approval-service",
      "y": 568,
      "label": "本關完成",
      "variant": "return"
    },
    {
      "id": "next-step",
      "from": "approval-service",
      "to": "routing-engine",
      "y": 602,
      "label": "取得下一關",
      "variant": "default"
    },
    {
      "id": "no-next",
      "from": "routing-engine",
      "to": "approval-service",
      "y": 632,
      "label": "無下一關 · 結案",
      "variant": "return",
      "note": "若有下一關：啟用該關，設 24 小時提醒與 48 小時升級，提交交易後結束"
    },
    {
      "id": "deduct",
      "from": "approval-service",
      "to": "balance-service",
      "y": 702,
      "label": "實扣額度",
      "variant": "emphasis"
    },
    {
      "id": "move-hours",
      "from": "balance-service",
      "to": "leave-db",
      "y": 732,
      "label": "預扣轉實扣",
      "variant": "emphasis",
      "note": "reserved_hours 減去時數，used_hours 加上時數"
    },
    {
      "id": "hours-moved",
      "from": "leave-db",
      "to": "balance-service",
      "y": 804,
      "label": "已更新",
      "variant": "return"
    },
    {
      "id": "deducted",
      "from": "balance-service",
      "to": "approval-service",
      "y": 834,
      "label": "已實扣",
      "variant": "return"
    },
    {
      "id": "approve-outbox",
      "from": "approval-service",
      "to": "leave-db",
      "y": 868,
      "label": "假單核准＋寫 outbox",
      "variant": "emphasis",
      "note": "同一交易：假單改為 approved，新增 leave.approved 事件列"
    },
    {
      "id": "committed",
      "from": "leave-db",
      "to": "approval-service",
      "y": 956,
      "label": "已提交",
      "variant": "return"
    },
    {
      "id": "approved",
      "from": "approval-service",
      "to": "rest-controller",
      "y": 986,
      "label": "已核准",
      "variant": "return"
    },
    {
      "id": "http-200",
      "from": "rest-controller",
      "to": "employee-portal",
      "y": 1016,
      "label": "200 已核准",
      "variant": "return"
    },
    {
      "id": "poll-outbox",
      "from": "outbox-publisher",
      "to": "leave-db",
      "y": 1062,
      "label": "讀取未發佈事件",
      "variant": "dashed"
    },
    {
      "id": "pending-event",
      "from": "leave-db",
      "to": "outbox-publisher",
      "y": 1092,
      "label": "leave.approved",
      "variant": "return"
    },
    {
      "id": "mark-published",
      "from": "outbox-publisher",
      "to": "leave-db",
      "y": 1126,
      "label": "發佈後標記已發佈",
      "variant": "dashed",
      "note": "經 RabbitMQ（AMQP）發佈；整合工作者同步出勤、薪資、行事曆，並通知申請人與代理人"
    }
