  "cards": [
    {
      "dot": "cyan",
      "title": "聚合邊界",
      "items": [
        "LeaveRequest 是聚合根：關卡與動作只能經由假單修改，並以 LeaveRepository 在同一交易保存。",
        "退回後重送時 round 加一，從被退回的關卡重新簽；舊的 ApprovalAction 保留。"
      ]
    },
    {
      "dot": "amber",
      "title": "會簽與加簽",
      "items": [
        "StepMode.ALL：approvers 全部同意才完成；ANY：任一人同意即完成；任一駁回則 isRejected。",
        "addSigner 在目前關卡後插入一關，insertedBy 記錄加簽的簽核人。"
      ]
    },
    {
      "dot": "violet",
      "title": "路由規則",
      "items": [
        "≤ 3 天由直屬主管簽；DaysThresholdRule 在 > 3 天時加部門主管關。",
        "LeaveTypeRule 對婚假、喪假、公假與 > 3 天病假加人資審核關並要求證明。"
      ]
    }
  ]
