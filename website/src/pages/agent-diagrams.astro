---
import SiteLayout from '../layouts/SiteLayout.astro';
import Navigation from '../components/Navigation.astro';
import { Content as English, getHeadings as englishHeadings } from '../content/agent-diagrams.en.md';
import { Content as Chinese, getHeadings as chineseHeadings } from '../content/agent-diagrams.zh.md';
import head from '../data/agent-diagrams-head.html?raw';
import css from '../styles/agent-diagrams.css?raw';
const { lang = 'en' } = Astro.props;
const Content = lang !== 'en' ? Chinese : English;
const sectionIds = ['responsibilities', 'setup', 'description-workflow', 'mermaid-input', 'cache-scenarios', 'repository-evidence', 'review-and-share', 'questions'];
const headings = (lang !== 'en' ? chineseHeadings() : englishHeadings()).filter(heading => heading.depth === 2).map((heading, index) => ({ ...heading, slug: sectionIds[index] }));

---
<SiteLayout page="agent-diagrams" lang={lang} head={head} css={css}>
  <div class="grid-bg" aria-hidden="true"></div>
  <Navigation page="agent-diagrams" />
  <main class="agent-guide">
    <header class="article-meta">
      <p>{lang !== 'en' ? '实践指南 · 编写 / 检查 / 分享' : 'Field guide · Author / Review / Share'}</p>
      <p>{lang !== 'en' ? '最近核对：2026-10-15 · 稳定版 3.1.0 · 提示词为示例输入，并非 Agent 实测记录。' : 'Last reviewed: 2026-10-15 · Stable 3.1.0 · Prompts are illustrative inputs, not recorded agent runs.'}</p>
    </header>
    <div class="article-grid">
      <nav class="article-toc" aria-label={lang !== 'en' ? '本页目录' : 'On this page'}>
        <p>{lang !== 'en' ? '本页目录' : 'On this page'}</p>
        <ol>{headings.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
      </nav>
      <article class="article-body"><Content /></article>
    </div>
  </main>
  <footer class="article-footer"><a href="start.html">{lang !== 'en' ? '配置你的 Agent →' : 'Set up your agent →'}</a><a href="guide.html">{lang !== 'en' ? '选择图表配方 →' : 'Choose a diagram recipe →'}</a></footer>
</SiteLayout>
